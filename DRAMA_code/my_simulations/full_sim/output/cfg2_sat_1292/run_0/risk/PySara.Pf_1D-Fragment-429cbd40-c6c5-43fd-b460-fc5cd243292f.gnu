reset															
set datafile separator ','														
set style data lines															
set term png																
set xlabel 'Lat [deg]'															
set xrange[-95.0:+95.0]									
set xtics nomirror																
set mxtics 4																		
set grid xtics ytics																
show grid																		
set boxwidth 0.001 
 																				
set title "DRAMA-SERAM\nglobal fatality prob. for an uncontrolled, latitude-band-limited re-entry \nrun ID: PySara\n Results: Fragment-429cbd40-c6c5-43fd-b460-fc5cd243292f"															
set ylabel 'Fatality Prob.[-]'											
set ytics nomirror																
set yrange[0:] 
set mytics 4																		
set format y '%.1te%+02T'														
set output 'PySara.Pf_1D-Fragment-429cbd40-c6c5-43fd-b460-fc5cd243292f.png'														
plot 'PySara.Risk-Fragment-429cbd40-c6c5-43fd-b460-fc5cd243292f.dat' u 1:4 w boxes lt 01 lw 01 notitle	

